# Usamos 'base' (aprox 18MB) en lugar de 'static'
# Esto proporciona las librerías glibc y libz que tu binario necesita ahora
FROM gcr.io/distroless/base-debian12:latest

WORKDIR /app

# Copiamos el binario comprimido por UPX
COPY target/backofficeAPI /app/backofficeAPI

# Variables para Render
ENV SERVER_PORT=${PORT}
ENV TZ=Europe/Madrid

USER 1000:1000

ENTRYPOINT ["/app/backofficeAPI"]