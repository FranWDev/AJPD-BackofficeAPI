FROM debian:bookworm-slim

WORKDIR /app

# Copiamos tu binario de Arch
COPY target/backofficeAPI /app/backofficeAPI

# Permisos de ejecución (importante en Debian)
RUN chmod +x /app/backofficeAPI

ENV SERVER_PORT=${PORT}
ENV TZ=Europe/Madrid

# Creamos un usuario para no correr como root
RUN useradd -m springuser
USER springuser

ENTRYPOINT ["/app/backofficeAPI"]